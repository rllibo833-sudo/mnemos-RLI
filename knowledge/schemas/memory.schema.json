{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnemos-rli.local/schemas/memory.schema.json",
  "title": "Mnemos Knowledge Memory Node",
  "type": "object",
  "required": ["schema_version", "id", "kind", "content"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "workspace_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "minLength": 1, "maxLength": 80},
    "title": {"type": "string", "maxLength": 512},
    "content": {"type": "string", "maxLength": 65536},
    "source": {"type": "object", "properties": {
      "type": {"type": "string"}, "uri": {"type": "string", "maxLength": 2048},
      "filename": {"type": "string", "maxLength": 512},
      "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
      "extraction_method": {"type": "string"}, "observed_at": {"type": "string", "format": "date-time"}
    }, "additionalProperties": true},
    "media": {"type": "object", "properties": {
      "category": {"enum": ["image", "document", "video", "audio", "code", "file"]},
      "mime_type": {"type": "string", "maxLength": 255},
      "size_bytes": {"type": "integer", "minimum": 0},
      "duration_ms": {"type": "integer", "minimum": 0},
      "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0},
      "local_only": {"type": "boolean"},
      "derivative_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
    }, "additionalProperties": true},
    "metadata": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "deleted_at": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

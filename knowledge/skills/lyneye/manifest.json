{
  "schema_version": 1,
  "name": "lyneye",
  "version": "0.1.0",
  "description": "Local-first image and selected-video-frame understanding for Mnemos.",
  "triggers": [
    "lihat",
    "foto",
    "gambar",
    "image",
    "vision",
    "frame",
    "video"
  ],
  "requires": [
    "host.mnemos.local"
  ],
  "knowledge_source": "mnemos-local-graph",
  "author": "Mnemos RLI",
  "entrypoint": "prompt.md",
  "capabilities": [
    "media.selected.read",
    "knowledge.memory.write",
    "knowledge.memory.read",
    "knowledge.graph.link"
  ],
  "permissions": [],
  "dependencies": [],
  "input": {
    "media_categories": [
      "image",
      "video"
    ],
    "requires_explicit_file_permission": true
  },
  "output": {
    "format": "mnemos-memory-node",
    "max_text_chars": 12000,
    "include_source_hash": true,
    "include_timestamps_for_video": true
  },
  "execution": {
    "preferred_provider": "local-ollama",
    "network_required": false,
    "upload_original_media": false,
    "allow_face_identification": false
  }
}

{
  "schema_version": 1,
  "name": "lynlamp",
  "version": "0.1.0",
  "description": "Map explicit light-control intent to allowlisted actions delegated to a trusted host.",
  "triggers": [
    "lampu",
    "nyalakan",
    "matikan",
    "redupkan",
    "brightness",
    "light"
  ],
  "requires": [
    "host.mnemos.local"
  ],
  "knowledge_source": "mnemos-local-graph",
  "author": "Mnemos RLI",
  "entrypoint": "SKILL.md",
  "capabilities": [
    "knowledge.memory.read",
    "knowledge.memory.write",
    "knowledge.graph.link",
    "device.light.intent"
  ],
  "dependencies": [],
  "permissions": [
    "device.light.control"
  ],
  "actions_file": "actions.json",
  "execution": {
    "requires_user_authorization": true,
    "requires_host_adapter": true,
    "arbitrary_commands": false
  }
}
